# Copie para ".env" (não versionado) se quiser testar a senha localmente,
# ou defina como variável de ambiente direto no painel do host de deploy.

# Porta do servidor (o Render define isso automaticamente — não precisa mexer lá).
PORT=3000

# Se AUTH_PASSWORD estiver definida, o app pede usuário/senha (HTTP Basic
# Auth) pra qualquer acesso — páginas e WebSocket. Se não estiver definida
# (padrão local), o app fica sem senha nenhuma, como no uso offline do evento.
AUTH_PASSWORD=
AUTH_USER=crisma
